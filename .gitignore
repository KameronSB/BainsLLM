# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env
.venv/

# Data: track the released corpus and the fitted 2k baseline tokenizer.
/data/**
!/data/raw/
!/data/raw/historical_50m/
!/data/raw/historical_50m/train.jsonl
!/data/raw/historical_50m/validation.jsonl
!/data/raw/historical_50m/test.jsonl

!/data/processed/
!/data/processed/historical_50m/
!/data/processed/historical_50m/byte_bpe-2000/
!/data/processed/historical_50m/byte_bpe-2000/tokenizer.json

# Runs / checkpoints
runs/*
!runs/.gitkeep
*.pt
*.pth
*.ckpt

# Notebooks
.ipynb_checkpoints/

